# ---- Atrio local config (copy to .env and adjust) ----
# Postgres (docker-compose service `db`; for bare-metal local use localhost)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atrio
DB_SSL=false

# Backend API base consumed by the frontend (Vite)
VITE_API_BASE=http://localhost:8000

# YOLO stenosis model (single source of truth)
# https://huggingface.co/rachitgoyell/stenosis-detection
HF_MODEL_REPO=rachitgoyell/stenosis-detection
HF_MODEL_FILE=best.pt
YOLO_CONF=0.25
YOLO_IOU=0.45
YOLO_IMGSZ=640

# Optional: Azure OpenAI Vision for artery naming (falls back to "Unknown" when unset)
# AZURE_API_KEY is accepted as a fallback for AZURE_OPENAI_API_KEY
AZURE_OPENAI_API_KEY=
AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=https://project-asd-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

# Optional: Gemini (frontend voice/correction helpers; mock mode when unset)
GEMINI_API_KEY=
